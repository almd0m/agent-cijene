# Kopiraj ovaj fajl u .env i upiši svoje vrijednosti. .env se NIKAD ne commituje.
RESEND_API_KEY=re_ovdje_tvoj_kljuc
# Mora biti ista adresa kojom si se registrovao na Resend (bez sopstvenog domena Resend šalje samo na nju).
REPORT_TO=tvoja.adresa@gmail.com
# Minimalni popust u procentima.
MIN_DISCOUNT=30
# Besplatan ključ sa https://aistudio.google.com/apikey . Bez njega se Idea preskače, a nejasni "muški" proizvodi izostavljaju.
GEMINI_API_KEY=
# Opciono: drugi Gemini model (podrazumijevano gemini-flash-lite-latest; gemini-flash-latest je ~50× sporiji).
GEMINI_MODEL=
# Adresa web stranice (Vercel). Ako je postavljena, email je kratak sa linkom; ako nije, email ima punu tabelu.
SITE_URL=
# 1 = u emailu prikaži samo nove akcije (kojih nije bilo u prošlom izvještaju).
ONLY_NEW=
